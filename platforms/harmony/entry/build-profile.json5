{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      // The core plus the NAPI bridge (libarmsx2.so). arm64 only: the recompilers are AArch64.
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "-DCMAKE_BUILD_TYPE=Release",
      "cppFlags": "",
      "abiFilters": ["arm64-v8a"]
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false
          }
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default"
    }
  ]
}
