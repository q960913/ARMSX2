// DualShock 2 inputs, in the order of PadDualshock2::Inputs (pcsx2/SIO/Pad/PadDualshock2.h).
// padInput() takes these indices.
export enum PadInput {
  UP = 0,
  RIGHT = 1,
  DOWN = 2,
  LEFT = 3,
  TRIANGLE = 4,
  CIRCLE = 5,
  CROSS = 6,
  SQUARE = 7,
  SELECT = 8,
  START = 9,
  L1 = 10,
  L2 = 11,
  R1 = 12,
  R2 = 13,
  L3 = 14,
  R3 = 15,
  ANALOG = 16,
  PRESSURE = 17,
  L_UP = 18,
  L_RIGHT = 19,
  L_DOWN = 20,
  L_LEFT = 21,
  R_UP = 22,
  R_RIGHT = 23,
  R_DOWN = 24,
  R_LEFT = 25,
}
